{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup (install + migrate + seed)",
      "type": "shell",
      "command": "pip install -r requirements.txt && python manage.py migrate && python manage.py seed_content",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "runserver",
      "type": "shell",
      "command": "python manage.py runserver 0.0.0.0:8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "test",
      "type": "shell",
      "command": "python manage.py test",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
