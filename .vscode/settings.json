{
  // No hardcoded interpreter path: pick it with
  // Ctrl+Shift+P -> "Python: Select Interpreter".
  // (The old value pointed at .venv/bin/python, which only exists on
  //  macOS/Linux — on Windows it is .venv\Scripts\python.exe.)
  "python.terminal.activateEnvironment": true,

  // Let Pylance resolve "config.*", "content.*", "core.*", "leads.*"
  // whether the folder you opened is the repo root or backend/ itself.
  "python.analysis.extraPaths": [
    "${workspaceFolder}",
    "${workspaceFolder}/backend"
  ],
  "python.autoComplete.extraPaths": [
    "${workspaceFolder}",
    "${workspaceFolder}/backend"
  ],

  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.diagnosticSeverityOverrides": {
    // Django ships no py.typed marker, so Pylance finds bundled stubs but not
    // the source and reports a false "could not be resolved from source".
    // The import works fine at runtime.
    "reportMissingModuleSource": "none"
  },

  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "[python]": {
    "editor.rulers": [88],
    "editor.formatOnSave": false
  },
  "[html]": {
    "editor.tabSize": 2
  },
  "emmet.includeLanguages": { "django-html": "html" },
  "files.associations": {
    "**/templates/**/*.html": "django-html"
  }
}
