# Uploaded files are data, not code.
# Defence in depth: even if a PHP file somehow lands here it must not run,
# and only real image types may be served.

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
SetHandler none

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'none'"
    Header always set Cross-Origin-Resource-Policy "same-origin"
</IfModule>

# Deny everything, then re-allow the image types we can produce.
# (Later sections override earlier ones, so order matters here.)
Require all denied

<FilesMatch "\.(jpg|jpeg|png|webp)$">
    Require all granted
</FilesMatch>
