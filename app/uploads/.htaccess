# Uploaded files are data, not code.
# Disable any PHP execution inside this directory (defense in depth).

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phar

# Only allow image files to be served; anything else is denied.
<FilesMatch "^(?!.*\.(jpg|jpeg|png|webp)$)">
    Require all denied
</FilesMatch>
