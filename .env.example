# =============================================================
#  PhysioElectric - Environment  (OPTIONAL)
#
#  You do NOT need this file: `docker compose up -d --build` works
#  without it. The `init` service generates strong random secrets
#  (DB password, DB root password, admin password) once and stores
#  them in the `secrets` volume - never in the repo.
#
#  Copy this file to .env only if you want to pin your own values:
#     cp .env.example .env
#  Anything you set here overrides the generated secret.
#
#  ADMIN_PASSWORD must pass the shared password policy (see README
#  "تولید رمز امن ادمین"): at least 16 characters in production and must
#  not be the old shipped default. The bootstrap admin's first login
#  forces a password rotation.
# =============================================================

# Port exposed on the host (the container itself listens on 8080)
APP_PORT=8080

# production | development
# development shows stack traces and lets OPcache revalidate the bind mount.
APP_ENV=production

# Clock used by PHP; the MySQL session timezone is pinned to the same offset.
APP_TIMEZONE=Asia/Tehran

# Public URL of the site (no trailing slash) — used for canonical,
# hreflang and Open Graph tags. Leave empty to derive it from the request
# Host header, restricted to TRUSTED_HOSTS.
SITE_BASE_URL=http://localhost:8080

# Hosts this app is allowed to generate absolute URLs for. Anything else is
# refused (host-header injection guard). Comma separated, *. wildcard allowed.
TRUSTED_HOSTS=localhost

# ---- Database ----
# Leave empty to use the generated /run/secrets/db_pass.
# Generate your own with:  openssl rand -base64 32
DB_PASS=
# NOTE: the MySQL root password is always generated by the `init`
# service into /run/secrets/db_root_pass; it is not settable here.

# ---- Admin account (created on first boot if it does not exist) ----
ADMIN_NAME=Admin
# Defaults to admin@physioelectric.com when left empty.
ADMIN_EMAIL=
# Leave empty to use the generated /run/secrets/admin_pass, which is
# printed once in `docker compose logs app`.
# Passes the shared password policy (16+ chars in production). Generate:
#   openssl rand -base64 24
# An operator-supplied password (this file, or docker-compose) logs in
# directly; a generated secret still forces a rotation at first login.
ADMIN_PASSWORD=

# Set to 1 to rewrite the bootstrap admin hash from ADMIN_PASSWORD on the
# next boot / next visit to /admin/login. Use this when the panel is
# unreachable after a forgotten password. Remove the flag afterwards.
ADMIN_PASSWORD_RESET=0

# ---- Session / brute-force policy (optional, defaults shown) ----
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ---- Uploads (optional, defaults shown) ----
MAX_UPLOAD_BYTES=2097152     # 2 MB
MAX_IMAGE_EDGE=6000          # max pixels per side
MAX_UPLOADS=2000             # hard cap on files in the media library

# ---- Browser hardening (optional, defaults shown) ----
CSP_ENABLED=true
# Escape hatch ONLY if you add an inline script without a nonce. Never in prod.
CSP_ALLOW_UNSAFE_INLINE=false
HSTS_MAX_AGE=31536000
SECURITY_LOG_ENABLED=true

# ---- Optional CAPTCHA on the public contact/order form (Cloudflare
#      Turnstile). Disabled by default — leave all three empty/unset.
#      Enabled only when provider=turnstile AND both keys are set.
#      Site key is public; SECRET_KEY must come from the environment and is
#      never rendered or logged. Keys: https://dash.cloudflare.com/ → Turnstile
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
