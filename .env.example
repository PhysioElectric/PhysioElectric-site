# =============================================================
#  PhysioElectric - Environment
#  Copy this file to .env and adjust the values:
#     cp .env.example .env
# =============================================================

# Port exposed on the host (http://localhost:8080)
APP_PORT=8080

# production | development
APP_ENV=production

# Public URL of the site (no trailing slash) — used for
# canonical, hreflang and Open Graph tags.
SITE_BASE_URL=http://localhost:8080

# ---- Database ----
DB_PASS=pe_secret_2026
DB_ROOT_PASS=pe_root_secret_2026

# ---- Admin account (created on first boot if it does not exist) ----
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@physioelectric.com
# CHANGE THIS! Minimum 10 characters recommended.
ADMIN_PASSWORD=Physio@2026
