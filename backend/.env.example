# --- core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Tehran
LOG_LEVEL=INFO

# --- database ---
# SQLite (default, no setup needed):
#   leave DATABASE_URL unset
# PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/physioelectric
DB_CONN_MAX_AGE=600

# --- security (production) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
CSRF_TRUSTED_ORIGINS=https://physioelectric.dev
CORS_ALLOWED_ORIGINS=

# --- api throttling ---
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_CONTACT=5/hour
THROTTLE_SUBSCRIBE=10/hour
THROTTLE_TRACK=60/hour

# --- request limits ---
API_MAX_BODY_BYTES=65536
DATA_UPLOAD_MAX_BYTES=524288

# --- email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@physioelectric.dev
CONTACT_NOTIFY_EMAILS=

# --- cache ---
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1
CACHE_TIMEOUT=300
